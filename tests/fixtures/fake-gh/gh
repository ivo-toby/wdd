#!/usr/bin/env python3
"""Fake `gh` for tests: no network, ever.

Contract mirrored from real `gh`:
- Every invocation appends its argv (as a JSON array, one per line) to the
  file named by $FAKE_GH_LOG, when that env var is set.
- `gh pr create ...` prints a single canned PR URL to stdout, matching real
  gh's behaviour of writing the new PR's URL to stdout.
- $FAKE_GH_FAIL=1 makes any invocation exit 1 with a message on stderr,
  after logging argv, so failure-path tests can still assert what was
  attempted before the failure.
"""

from __future__ import annotations

import json
import os
import sys

CANNED_PR_URL = "https://github.invalid/pr/1"


def main() -> int:
    argv = sys.argv[1:]
    log_path = os.environ.get("FAKE_GH_LOG")
    if log_path:
        with open(log_path, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(argv) + "\n")

    if os.environ.get("FAKE_GH_FAIL") == "1":
        sys.stderr.write("fake-gh: forced failure (FAKE_GH_FAIL=1)\n")
        return 1

    if len(argv) >= 2 and argv[0] == "pr" and argv[1] == "create":
        print(CANNED_PR_URL)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
